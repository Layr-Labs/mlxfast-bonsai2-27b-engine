est tests -> Need to cover all specified cases.\n\n4.  **Refine Code & Tests:**\n   Let's write out the full solution with tests.\n\n   ```python\n   from typing import Iterable, List, Tuple\n\n   def","generatedTokenIDs":[8160,579,264,7047,1817,25,271,16,13,220,2972,15771,2598,279,2570,5952,64700,198,256,471,2972,2425,64700,1473,49124,314,7308,47029,2388,11,809,44646,13139,13,198,256,471,2972,4935,64700,357,491,1103,314,81859,26126,10300,539,1151,13,198,256,471,2972,12554,64700,198,257,471,84282,13139,1332,1510,2388,835,809,63,440,1510,1094,1401,27653,198,257,471,38754,29588,26126,318,68,1257,2487,74988,16,11,220,17,1089,498,17,11,220,18,60,63,1411,74988,16,11,220,18,60,57208,198,257,471,38754,48142,26126,13,198,257,471,3054,524,64914,279,1879,13,198,257,471,13365,4147,49124,13,198,257,471,28763,913,29642,13,198,257,471,28763,264,61446,4479,889,13,198,257,471,28763,1510,25868,63,6813,17661,25,4147,1879,11,632,27379,1879,11,23283,26126,11,29588,22005,11,7968,2663,11,21814,26126,11,321,8060,13139,13,198,257,471,79091,854,321,3433,22373,1238,279,1970,13,198,256,471,2972,1905,64700,351,29292,220,18,13,16,17,5129,6522,47801,318,1445,1510,8921,76729,20409,18162,3181,57208,1061,369,1066,2193,11,3070,914,5774,7556,279,7873,11,694,353,1220,2426,279,1970,1647,6376,321,12654,291,13,271,17,13,220,2972,26943,6765,64700,198,256,471,2972,2425,10206,64700,4109,1754,6505,13,1368,1510,2388,835,809,7561,4673,1510,1094,1401,27653,198,256,471,2972,69246,64700,15495,26126,539,1151,854,13,1368,8211,513,5951,11,3269,539,809,854,318,12439,694,10631,364,27224,553,198,256,471,2972,44,92007,64700,52516,1472,10300,26126,13,83392,264,1510,3127,4747,63,321,1510,3127,6018,27653,1690,1754,9581,47029,82,11,378,8,43143,198,257,471,1368,1510,82,2564,1428,6018,7561,10562,25,1510,3127,6018,283,1866,8497,6018,11,378,44646,198,257,471,18236,11,8472,74988,3127,4747,11,1428,6018,60,63,310,1067,11,321,1151,264,491,9581,440,47029,82,11,378,8,27653,198,256,471,2972,11320,4886,64700,21539,1879,1411,460,1510,12